{
  "name": "htmlcsspdf",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:lurk": "vite dev --port 1337",
    "build": "vite build",
    "deploy": "bun run build && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit && biome check",
    "check:fix": "biome check --write",
    "cf-typegen": "wrangler types",
    "postinstall": "WRANGLER_LOG=warn bun run --silent cf-typegen"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@cloudflare/puppeteer": "^1.4.0",
    "@cloudflare/vite-plugin": "^1.53.1",
    "@cloudflare/workers-types": "^5.20260821.1",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^29.1.1",
    "oxc-transform-react": "^0.147.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-start": "^1.168.49",
    "better-auth": "^1.7.2",
    "codemirror": "^6.0.2",
    "lucide-react": "^1.37.0",
    "parse5": "^8.0.1",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-dropzone": "^20.1.1"
  }
}
