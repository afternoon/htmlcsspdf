{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "htmlcsspdf",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "browser": {
    "binding": "BROWSER"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "htmlcsspdf",
      "database_id": "0f9ff16f-c44e-4ca1-852c-bd55eabb1fb0",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "THUMBNAILS",
      "bucket_name": "htmlcsspdf-thumbnails"
    }
  ],
  "observability": {
    "enabled": true
  }
}
